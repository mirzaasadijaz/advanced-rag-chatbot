# Copy this file to .env in the same folder (backend/.env) and fill in your keys.
# cp .env.example .env

# --- Required: Gemini (LLM) ---
GOOGLE_API_KEY=

# --- Optional: Tavily (web-search fallback tool) ---
# Without this, the "web_search" node/route is skipped and the assistant
# answers from the knowledge base or its own general knowledge only.
# Free key: https://tavily.com
TAVILY_API_KEY=

HF_TOKEN=
# --- Embeddings (local, free, runs on CPU via ONNX - no API key needed) ---
# First run downloads the model from Hugging Face (~130MB), so it needs
# internet access once. See fastembed's docs for other supported models.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage (created automatically; paths are relative to backend/) ---
CHROMA_PERSIST_DIR=./data/chroma_db
DOCSTORE_PATH=./data/docstore.jsonl

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Advanced RAG knobs ---
RETRIEVAL_K=6                   # chunks pulled by hybrid search before reranking
RERANK_TOP_N=4                  # chunks kept after reranking, sent to the LLM
MAX_SELF_CORRECT_RETRIES=2      # bounds the groundedness-check retry loop
ENABLE_RERANKER=true            # set false to skip the FlashRank cross-encoder step

# --- Web scraping ---
SCRAPE_MAX_PAGES_DEFAULT=5
SCRAPE_MAX_PAGES_LIMIT=25

# --- API ---
# Comma-separated origins allowed to call the API. "*" is fine for local use;
# lock this down if you deploy the backend somewhere reachable by others.
ALLOWED_ORIGINS=*
